<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MyApp</title>

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>

<body class="bg-slate-950 text-slate-100">

    @RenderBody()

    @await RenderSectionAsync(
        "Scripts",
        required: false)
</body>
</html>