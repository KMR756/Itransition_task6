@model Itransition_task6.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Welcome";
}

<div class="min-h-screen bg-gray-900 text-gray-900  flex justify-center">

    <div class="max-w-screen-xl m-0 sm:m-30
        bg-white shadow
        sm:rounded-lg
        flex justify-center flex-1
        overflow-hidden">

        

        <div class="lg:w-1/2 xl:w-5/12
            p-6 sm:p-12">

            

            <div class="flex justify-center">

                <div class="flex h-22 w-22
                    items-center justify-center
                    rounded-2xl
                    bg-indigo-500
                    text-xl font-extrabold
                    text-white shadow-lg p-10">

                    MyApp

                </div>

            </div>



            <div class="mt-12
                flex flex-col items-center">

                <h1 class="text-2xl xl:text-3xl
                    font-extrabold
                    text-gray-900">

                    Welcome to MyApp

                </h1>

                <p class="mt-3 text-center
                    text-sm text-gray-500">

                    Build logic circuits together,
                    from anywhere.

                </p>


                <div class="w-full flex-1 mt-8">


                    

                    <div class="mx-auto max-w-xs
                        rounded-xl
                        bg-indigo-50
                        border border-indigo-100
                        px-5 py-4">

                        <div class="flex items-start gap-3">

                            <div class="flex h-9 w-9
                                shrink-0
                                items-center justify-center
                                rounded-lg
                                bg-indigo-500
                                text-white">

                                ⚡

                            </div>

                            <div>

                                <p class="text-sm
                                    font-semibold
                                    text-gray-800">

                                    No account required

                                </p>

                                <p class="mt-1 text-xs
                                    leading-relaxed
                                    text-gray-500">

                                    Enter your display name
                                    and start collaborating
                                    instantly.

                                </p>

                            </div>

                        </div>

                    </div>


                   

                    <div class="my-10
                        border-b text-center">

                        <div class="leading-none
                            px-2 inline-block
                            text-sm text-gray-500
                            tracking-wide
                            font-medium
                            bg-white
                            transform
                            translate-y-1/2">

                            Enter your workspace name

                        </div>

                    </div>


                   

                    <form asp-action="Login"
                          method="post"
                          class="mx-auto max-w-xs">

                        @Html.AntiForgeryToken()


                        <!-- NAME -->

                        <label asp-for="Name"
                               class="block mb-2
                            text-sm font-medium
                            text-gray-700">

                            Enter Your Name

                        </label>


                        <input asp-for="Name"
                               autocomplete="off"
                               autofocus
                              
                               class="w-full px-8 py-4
                        rounded-lg
                        font-medium
                        bg-gray-100
                        border border-gray-200
                        placeholder-gray-400
                        text-sm
                        text-gray-900
                        transition-all
                        duration-300
                        focus:outline-none
                        focus:border-indigo-400
                        focus:bg-white
                        focus:ring-2
                        focus:ring-indigo-100" />


                        <span asp-validation-for="Name"
                              class="mt-2 block
                            text-xs text-red-500">
                        </span>


                        

                        <button type="submit"
                                class="mt-5
                            tracking-wide
                            font-semibold
                            bg-indigo-500
                            text-white
                            w-full py-4
                            rounded-lg
                            hover:bg-indigo-600
                            transition-all
                            duration-300
                            ease-in-out
                            flex items-center
                            justify-center
                            focus:outline-none
                            focus:ring-2
                            focus:ring-indigo-300
                            focus:ring-offset-2">

                            <svg class="w-6 h-6 -ml-2"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 viewBox="0 0 24 24">

                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />

                                <polyline points="10 17 15 12 10 7" />

                                <line x1="15"
                                      y1="12"
                                      x2="3"
                                      y2="12" />

                            </svg>

                            <span class="ml-3">

                                Enter CircuitFlow

                            </span>

                        </button>


                        

                        <p class="mt-6
                            text-xs
                            text-gray-500
                            text-center
                            leading-relaxed">

                            Your name is only used as your
                            <span class="font-medium text-gray-700">
                                visual identifier
                            </span>
                            inside collaborative circuits.

                        </p>

                    </form>

                </div>

            </div>

        </div>


      

        <div class="flex-1
            bg-indigo-100
            text-center
            hidden lg:flex">

            <div class="m-12 xl:m-16
                w-full
                rounded-2xl
                bg-indigo-200
                flex items-center
                justify-center
                overflow-hidden
                relative">

             

                <div class="absolute inset-0
                    opacity-30">

                    <div class="absolute
                        top-20 left-20
                        h-24 w-24
                        rounded-full
                        bg-indigo-400">
                    </div>

                    <div class="absolute
                        bottom-24 right-20
                        h-32 w-32
                        rounded-full
                        bg-indigo-300">
                    </div>

                </div>


              

                <div class="relative w-full
                    max-w-lg px-10">

                    <div class="text-left">

                        <div class="mb-3
                            inline-flex
                            rounded-full
                            bg-white/80
                            px-4 py-2
                            text-xs
                            font-semibold
                            text-indigo-600
                            shadow-sm">

                            ● LIVE COLLABORATION

                        </div>


                        <h2 class="text-4xl
                            xl:text-5xl
                            font-extrabold
                            tracking-tight
                            text-indigo-950">

                            Build circuits.
                            <br />

                            <span class="text-indigo-600">
                                Together.
                            </span>

                        </h2>


                        <p class="mt-6
                            max-w-md
                            text-indigo-900/70
                            leading-relaxed">

                            Design, connect and experiment
                            with logical circuits while your
                            teammates collaborate with you
                            in real time.

                        </p>

                    </div>


                 

                    <div class="mt-10
                        rounded-2xl
                        border border-white/70
                        bg-white/80
                        p-6
                        shadow-xl
                        backdrop-blur">

                        <div class="flex
                            items-center
                            justify-between
                            mb-5">

                            <span class="text-xs
                                font-semibold
                                text-gray-500">

                                CIRCUIT PREVIEW

                            </span>

                            <span class="flex
                                items-center gap-2
                                text-xs
                                text-emerald-600">

                                <span class="h-2 w-2
                                    rounded-full
                                    bg-emerald-500">
                                </span>

                                Connected

                            </span>

                        </div>


                      

                        <div class="flex
                            items-center
                            justify-center
                            gap-3">

                            <div class="h-10 w-10
                                rounded-lg
                                bg-emerald-100
                                border
                                border-emerald-300
                                flex items-center
                                justify-center
                                text-xs
                                font-bold
                                text-emerald-700">

                                IN

                            </div>


                            <div class="h-0.5 w-10
                                bg-indigo-300">
                            </div>


                            <div class="h-14 w-20
                                rounded-xl
                                bg-indigo-500
                                flex items-center
                                justify-center
                                text-sm
                                font-bold
                                text-white
                                shadow-md">

                                AND

                            </div>


                            <div class="h-0.5 w-10
                                bg-indigo-300">
                            </div>


                            <div class="h-10 w-10
                                rounded-lg
                                bg-sky-100
                                border
                                border-sky-300
                                flex items-center
                                justify-center
                                text-xs
                                font-bold
                                text-sky-700">

                                OUT

                            </div>

                        </div>


                        

                        <div class="mt-3
                            flex justify-center">

                            <div class="h-0.5 w-10
                                bg-indigo-300
                                -translate-x-12">
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}