@{
    ViewData["Title"] = "Dashboard";

    var displayName =
        Context.Session.GetString("DisplayName");
}

<div class="min-h-screen bg-slate-950">

    <header class="border-b border-slate-800">

        <div class="mx-auto flex max-w-7xl
            items-center justify-between
            px-6 py-5">

            <div class="flex items-center gap-3">

                <div class="flex h-10 w-10
                    items-center justify-center
                    rounded-xl bg-indigo-500
                    font-bold">
                    CF
                </div>

                <div>
                    <div class="font-semibold">
                        CircuitFlow
                    </div>

                    <div class="text-xs text-slate-500">
                        Collaborative logic workspace
                    </div>
                </div>

            </div>

            <div class="flex items-center gap-4">

                <div class="text-sm text-slate-400">
                    <span class="text-slate-200">
                        @displayName
                    </span>
                </div>

                <form asp-action="Logout"
                      method="post">

                    <button class="rounded-lg border
                        border-slate-700
                        px-3 py-2 text-sm
                        text-slate-400
                        hover:bg-slate-800">

                        Leave
                    </button>

                </form>

            </div>

        </div>

    </header>


    <main class="mx-auto max-w-7xl px-6 py-10">

        <div class="mb-10 flex items-end
            justify-between">

            <div>
                <p class="text-sm text-indigo-400">
                    Workspace
                </p>

                <h1 class="mt-2 text-4xl font-bold">
                    Your circuits
                </h1>

                <p class="mt-2 text-slate-400">
                    Create a circuit or join an existing
                    collaboration.
                </p>
            </div>

            <button onclick="openCreateModal()"
                    class="rounded-xl bg-indigo-500
                px-5 py-3 font-semibold
                hover:bg-indigo-400">

                + New circuit
            </button>

        </div>


        <div id="circuits"
             class="grid gap-5
            sm:grid-cols-2
            lg:grid-cols-3">
        </div>

    </main>

</div>


<div id="createModal"
     class="fixed inset-0 z-50 hidden
    items-center justify-center
    bg-black/70 px-6">

    <div class="w-full max-w-lg
        rounded-3xl border border-slate-800
        bg-slate-900 p-7">

        <div class="mb-6">
            <h2 class="text-xl font-bold">
                Create circuit
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Start a new collaborative workspace.
            </p>
        </div>

        <input id="circuitName"
               placeholder="Circuit name"
               class="mb-3 w-full rounded-xl
        border border-slate-700
        bg-slate-950
        px-4 py-3 outline-none
        focus:border-indigo-500" />

        <textarea id="circuitDescription"
                  placeholder="Description"
                  rows="3"
                  class="w-full rounded-xl
        border border-slate-700
        bg-slate-950
        px-4 py-3 outline-none
        focus:border-indigo-500">
    </textarea>

    <div class="mt-4">

        <label class="text-sm text-slate-400">
            Grid size
        </label>

        <select id="gridSize"
                class="mt-2 w-full rounded-xl
            border border-slate-700
            bg-slate-950
            px-4 py-3">

            <option value="10">10 px</option>
            <option value="20" selected>20 px</option>
            <option value="30">30 px</option>
            <option value="40">40 px</option>

        </select>

    </div>

    <div class="mt-7 flex justify-end gap-3">

        <button onclick="closeCreateModal()"
                class="rounded-xl px-4 py-2
            text-slate-400
            hover:bg-slate-800">

            Cancel
        </button>

        <button onclick="createCircuit()"
                class="rounded-xl bg-indigo-500
            px-5 py-2 font-semibold
            hover:bg-indigo-400">

            Create

        </button>

    </div>

</div>

</div>

@section Scripts {

    <script src="~/js/dashboard.js"></script>

}